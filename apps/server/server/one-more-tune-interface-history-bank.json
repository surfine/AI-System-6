    {
      "id": "omt-ui-ns33-dock-dots",
      "domain": "interface_history",
      "topic": "interface_archaeology",
      "variant": "text_scenario",
      "subject": {
        "system": "NeXTSTEP",
        "version": "3.3",
        "historicalYear": 1995
      },
      "knowledgeKind": "state_meaning",
      "prompt": {
        "zh": "NeXTSTEP 3.3 的 Dock 图标左下角出现三个小点，通常表示什么？",
        "en": "What do three small dots at the lower left of a docked icon mean in NeXTSTEP 3.3?"
      },
      "options": [
        {
          "id": "a",
          "zh": "该应用尚未运行",
          "en": "The application is not running"
        },
        {
          "id": "b",
          "zh": "该应用正在运行",
          "en": "The application is running"
        },
        {
          "id": "c",
          "zh": "有窗口已被缩小",
          "en": "A window has been miniaturized"
        },
        {
          "id": "d",
          "zh": "文稿有未保存修改",
          "en": "A document has unsaved changes"
        }
      ],
      "answerId": "a",
      "explanation": {
        "zh": "原指南用三个点标记尚未运行的 Dock 应用。",
        "en": "The guide assigns the dots to docked applications that are not running."
      },
