# Secrets never enter the repo. Production values live only in
# /etc/ai-system6/env on the server; platform/web/ai-system6.env.example (committed)
# carries placeholders. tooling/verify-web-release-safety.mjs is the gate that
# stops a stray one from reaching the public site.
.env
.env.*
!.env.example
*.pem
*.key
!**/system.css-reference/**/*.key
system.css-reference/fonts/modern/
*.7z
*.mp4
# The official-site hero clip is a shipped asset, not a working file.
!site/img/hero-desktop.mp4
internal/evidence/drafts/hero-frames/
*.pdf

# vendored reference clones (own .git) and local scratch output
external/
internal/evidence/drafts/codex-snapshots/
internal/evidence/drafts/promo-video-work/
internal/evidence/drafts/official-site/
internal/archive/promo/output/
internal/archive/promo/recordings/
