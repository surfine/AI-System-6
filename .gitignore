internal/evidence/drafts/theme-lab-fidelity-cache/
# Appearance pixel baselines are machine-local: font rasterization differs per
# host, so a committed baseline would false-fail on every other machine. The
# gate is a local release condition (verify:ship), like the fidelity cache.
internal/evidence/drafts/appearance-baseline/
internal/evidence/drafts/appearance-current/
internal/evidence/drafts/appearance-noise/
tests/appearance-snapshot.json
internal/evidence/drafts/theme-lab-fidelity/
internal/evidence/drafts/appearance-app-coverage/
internal/evidence/drafts/appearance-phase5/
# local era icon reference caches (third-party captures / scratch renders);
# owned measurements, provenance and built icons live in apps/desktop/assets/themes/*/icons
internal/evidence/drafts/snow-leopard-icon-reference/
internal/evidence/drafts/liquid-glass-reference/
internal/evidence/drafts/yosemite-icon-reference/
internal/evidence/drafts/yosemite-icon-render/
internal/evidence/drafts/classic-icon-references/
# three-family coverage evidence (window sweeps, computed-style records,
# icon-crop review sheets); owned metrics live in docs/THEME-FAMILY-REPORT.md
internal/evidence/drafts/theme-coverage/
# era icon comparison/reference boards (rendered evidence, not product assets)
internal/evidence/drafts/era-icons/
internal/evidence/drafts/icon-generation/
# before/after render evidence for the Liquid Glass icon family
internal/evidence/drafts/liquid-glass-icons/
# local Python scratch caches
tooling/__pycache__/
__pycache__/
# local personal scratch output (audit dumps, temp exports)
internal/evidence/drafts/coverage/
# Per-commit HIG interaction audit screenshots, traces, videos, and device receipts.
# The canonical report and machine-readable ledgers live outside drafts/.
internal/evidence/drafts/hig-ui-ux-audit/
# local 15MB test photo (bg-1..6 are the shipped backgrounds)
internal/evidence/drafts/liquid-cover/test-shot.jpg
platform/macos/native/nohup.out
.wrangler/
# j-space controller ledger (per-task state, never committed)
.jspace/
