--- a/os/emscripten/pre.js
+++ b/os/emscripten/pre.js
@@ -30,6 +30,30 @@

     Module.addRunDependency('syncfs');
     FS.syncfs(true, function (err) {
+        /* AI System 6: on the first run, write a default openttd.cfg so the
+         * game starts in Simplified Chinese with the bundled CJK pixel font.
+         * The embedding shell page supplies the content, because only the
+         * page knows the screen size (gui_scale). On every later run, only
+         * the resolution line is rewritten: the game reads it once at boot,
+         * and the SDL port does not follow canvas size changes, so a stale
+         * resolution would stretch the whole game surface. */
+        try {
+            var cfg_path = personal_dir + '/openttd.cfg';
+            if (Module.openttdDefaultConfig && !FS.analyzePath(cfg_path).exists) {
+                FS.writeFile(cfg_path, Module.openttdDefaultConfig);
+            }
+            var res = typeof Module.openttdResolution === 'function'
+                ? Module.openttdResolution() : Module.openttdResolution;
+            if (res && FS.analyzePath(cfg_path).exists) {
+                var cfg = FS.readFile(cfg_path, { encoding: 'utf8' });
+                var updated = /^resolution *=.*$/m.test(cfg)
+                    ? cfg.replace(/^resolution *=.*$/m, 'resolution = ' + res)
+                    : cfg.replace(/^\[misc\]$/m, '[misc]\nresolution = ' + res);
+                if (updated !== cfg) FS.writeFile(cfg_path, updated);
+            }
+        } catch (e) {
+            console.error('openttd.cfg seeding failed', e);
+        }
         Module.removeRunDependency('syncfs');
     });

--- a/src/network/network.cpp
+++ b/src/network/network.cpp
@@ -1320,6 +1320,14 @@
 void CDECL em_openttd_add_server(const char *connection_string)
 {
 	NetworkAddServer(connection_string, false, true);
+}
+
+/* AI System 6: let the embedding page resize the game surface when the
+ * browser viewport changes (phone rotation, desktop window resize). The
+ * SDL emscripten port does not follow canvas size changes on its own. */
+void CDECL em_openttd_set_resolution(int w, int h)
+{
+	ChangeResInGame(std::max(64, w), std::max(64, h));
 }

 }
