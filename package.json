{
  "name": "ai-system-6",
  "version": "1.0.39",
  "description": "A quiet, intentional AI desktop environment inspired by Macintosh System 6.",
  "license": "MIT",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "audit:duplicates": "node scripts/audit-css-duplicates.mjs",
    "audit:floppy": "node scripts/audit-floppy-residue.mjs",
    "audit:liquid-twins": "node scripts/audit-liquid-twins.mjs",
    "audit:theme-coverage": "node scripts/audit-app-theme-coverage.mjs",
    "build": "npm run build:app",
    "build:accepted-generated-era-icons": "node scripts/build-accepted-generated-era-icons.mjs",
    "build:app": "node scripts/build-app-bundle.mjs",
    "build:aqua-core-icons": "node scripts/build-aqua-core-icons.mjs",
    "build:classic-icons": "node scripts/build-classic-family-icons.mjs",
    "build:cmf-renderer-vendor": "node scripts/build-cmf-renderer-vendor.mjs",
    "build:docmap-acceptance-board": "node scripts/build-docmap-acceptance-board.mjs",
    "build:era-icons": "node scripts/build-era-icons.mjs",
    "build:icon-continuity-board": "node scripts/build-icon-continuity-board.mjs",
    "build:liquid-glass-core-icons": "node scripts/build-liquid-glass-core-icons.mjs",
    "build:liquid-glass-imagegen-icons": "node scripts/build-liquid-glass-imagegen-icons.mjs",
    "build:platinum-core-icons": "node scripts/build-platinum-core-icons.mjs",
    "build:platinum-icons": "node scripts/build-era-icons.mjs --theme platinum",
    "build:snow-leopard-core-icons": "node scripts/build-snow-leopard-core-icons.mjs",
    "build:stream-markdown-vendor": "node scripts/build-stream-markdown-vendor.mjs",
    "build:yosemite-core-icons": "node scripts/build-yosemite-core-icons.mjs",
    "check:release-assets": "node scripts/check-release-assets.mjs",
    "compare:theme-lab:canonical": "npm run build:app && node scripts/theme-lab-fidelity.mjs",
    "icons:generated:audit": "node scripts/generated-era-icon-pipeline.mjs audit",
    "icons:generated:board": "node scripts/generated-era-icon-pipeline.mjs board",
    "icons:generated:generate": "node scripts/generated-era-icon-pipeline.mjs generate",
    "icons:generated:import": "node scripts/generated-era-icon-pipeline.mjs import",
    "icons:generated:prepare": "node scripts/generated-era-icon-pipeline.mjs prepare",
    "perf:budget": "node scripts/verify-floppy-budget.mjs",
    "prebuild:app": "npm run build:stream-markdown-vendor && npm run build:cmf-renderer-vendor",
    "prepare:runtime": "npm run build:app && npm run check:release-assets",
    "presmoke:release": "npm run build:app",
    "prestart": "npm run build:app",
    "screenshot:windows": "node scripts/screenshot-window-coverage.mjs",
    "sign:mac-app": "node scripts/sign-mac-app.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "snapshot:theme-lab": "npm run build:app && node scripts/theme-lab-snapshot.mjs --update",
    "start": "node src/server.js",
    "test": "npm run verify:features",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.mjs",
    "verify:appearance-apps": "npm run build:app && node scripts/verify-appearance-app-coverage.mjs",
    "verify:checkjs": "node scripts/verify-frontend-jsdoc.mjs",
    "verify:css": "node scripts/verify-css.mjs",
    "verify:data": "node scripts/verify-data-boundary.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "verify:docs": "node scripts/verify-doc-locales.mjs",
    "verify:feature": "node scripts/verify-features.mjs",
    "verify:features": "node scripts/verify-features.mjs",
    "verify:floppy": "node scripts/verify-floppy-budget.mjs",
    "verify:public": "node scripts/verify-public-tree.mjs",
    "verify:quick": "node scripts/verify-quick.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:ship": "node scripts/verify-ship.mjs",
    "verify:ship:fast": "node scripts/verify-ship.mjs --fast",
    "verify:src": "npm --prefix src run typecheck",
    "verify:theme-icons": "node scripts/build-theme-icon-css.mjs --check",
    "verify:theme-lab": "npm run build:app && node scripts/theme-lab-snapshot.mjs --verify",
    "verify:theme-lab:fidelity": "npm run build:app && node scripts/verify-theme-lab-fidelity.mjs",
    "verify:version": "node scripts/verify-version-consistency.mjs"
  },
  "overrides": {
    "sanitize-html": "2.17.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^18.19.130",
    "esbuild": "^0.25.10",
    "pkg": "^5.8.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.1.0",
    "@lmstudio/sdk": "^1.5.0",
    "@paddlejs-models/ocr": "^1.2.4",
    "canvas": "^3.2.3",
    "https-proxy-agent": "^5.0.1",
    "pdfjs-dist": "4.8.69",
    "stream-markdown-parser": "^1.0.5",
    "tesseract.js": "^7.0.0",
    "three": "^0.184.0"
  }
}
