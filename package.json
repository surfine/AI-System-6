{
  "name": "ai-system-6",
  "version": "1.0.12",
  "description": "A quiet, intentional AI desktop environment inspired by Macintosh System 6.",
  "license": "MIT",
  "main": "src/server.js",
  "bin": "src/server.js",
  "pkg": {
    "assets": [
      "assets/cmf/**/*",
      "assets/liquid-cover/bg-*.jpg",
      "assets/app-icon/manifest.json",
      "assets/app-icon/app-icon-180.png",
      "assets/app-icon/app-icon-192.png",
      "assets/app-icon/app-icon-512.png",
      "assets/ocr/paddle/**/*",
      "LICENSE",
      "build-info.json",
      "index.html",
      "app.bundle.js",
      "scripts/markitdown-adapter.py",
      "scripts/transcribe-audio-macos.swift",
      "scripts/transcribe-audio-macos26.swift",
      "app/**/*.js",
      "app/generated/*.json",
      "app/vendor/markmap/*.js",
      "assets/**/*.svg",
      "data/**/*.json",
      "app.js",
      "styles.css",
      "styles.bundle.css",
      "ocr/tessdata/*.traineddata.gz",
      "node_modules/@paddlejs-models/ocr/package.json",
      "node_modules/@paddlejs-models/ocr/lib/**/*.js",
      "node_modules/@paddlejs-mediapipe/opencv/package.json",
      "node_modules/@paddlejs-mediapipe/opencv/library/**/*",
      "node_modules/@paddlejs/paddlejs-core/package.json",
      "node_modules/@paddlejs/paddlejs-core/lib/**/*",
      "node_modules/@paddlejs/paddlejs-backend-webgl/package.json",
      "node_modules/@paddlejs/paddlejs-backend-webgl/lib/**/*",
      "node_modules/tesseract.js/src/**/*.js",
      "node_modules/tesseract.js-core/*.wasm",
      "node_modules/tesseract.js-core/*.wasm.js",
      "node_modules/@lmstudio/sdk/package.json",
      "node_modules/@lmstudio/sdk/dist/**/*",
      "node_modules/@lmstudio/lms-isomorphic/package.json",
      "node_modules/@lmstudio/lms-isomorphic/dist/cjs/**/*",
      "node_modules/chalk/package.json",
      "node_modules/chalk/source/**/*",
      "node_modules/ansi-styles/package.json",
      "node_modules/ansi-styles/index.js",
      "node_modules/color-convert/package.json",
      "node_modules/color-convert/*.js",
      "node_modules/color-name/package.json",
      "node_modules/color-name/index.js",
      "node_modules/supports-color/package.json",
      "node_modules/supports-color/index.js",
      "node_modules/has-flag/package.json",
      "node_modules/has-flag/index.js",
      "node_modules/jsonschema/package.json",
      "node_modules/jsonschema/lib/**/*.js",
      "node_modules/zod-to-json-schema/package.json",
      "node_modules/zod-to-json-schema/dist/cjs/**/*",
      "node_modules/ws/package.json",
      "node_modules/ws/index.js",
      "node_modules/ws/lib/**/*.js",
      "node_modules/pdfjs-dist/legacy/build/*.mjs",
      "node_modules/pdfjs-dist/cmaps/*.bcmap",
      "node_modules/pdfjs-dist/standard_fonts/*",
      "node_modules/canvas/build/Release/**/*",
      "system.css-reference/cursors/watch.png",
      "system.css-reference/fonts/*.woff",
      "system.css-reference/fonts/*.woff2"
    ],
    "targets": [
      "node18-macos-x64",
      "node18-macos-arm64",
      "node18-win-x64"
    ]
  },
  "scripts": {
    "test": "npm run verify:features",
    "prestart": "npm run build:app",
    "start": "node src/server.js",
    "prebuild:app": "npm run build:stream-markdown-vendor && npm run build:cmf-renderer-vendor && npm run build:ai-prompt-files",
    "build:app": "node scripts/build-app-bundle.mjs",
    "build:legacy-webkit": "node scripts/build-legacy-webkit-bundle.mjs",
    "build:cmf-renderer-vendor": "node scripts/build-cmf-renderer-vendor.mjs",
    "build:stream-markdown-vendor": "node scripts/build-stream-markdown-vendor.mjs",
    "build:ai-prompt-files": "node scripts/build-ai-prompt-files.mjs",
    "check:release-assets": "node scripts/check-release-assets.mjs",
    "prepare:runtime": "npm run build:app && npm run check:release-assets",
    "audit:floppy": "node scripts/audit-floppy-residue.mjs",
    "export:native-resources": "node scripts/export-native-resources.mjs",
    "verify:docs": "node scripts/verify-doc-locales.mjs",
    "verify:src": "npm --prefix src run typecheck",
    "verify:floppy": "node scripts/verify-floppy-budget.mjs",
    "perf:budget": "node scripts/verify-floppy-budget.mjs",
    "verify:quick": "node scripts/verify-quick.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:features": "node scripts/verify-features.mjs",
    "verify:feature": "node scripts/verify-features.mjs",
    "verify:data": "node scripts/verify-data-boundary.mjs",
    "verify:native-action-audit": "node scripts/verify-native-action-audit.mjs",
    "verify:native-parity-ledger": "node scripts/verify-native-parity-ledger.mjs",
    "verify:css": "node scripts/verify-css.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "eval:mingming-outline": "node scripts/eval-mingming-outline.mjs",
    "audit:liquid-twins": "node scripts/audit-liquid-twins.mjs",
    "audit:duplicates": "node scripts/audit-css-duplicates.mjs",
    "verify:visual": "npm run build:app && node scripts/visual-snapshot.mjs --verify",
    "snapshot:css": "npm run build:app && node scripts/css-surface-snapshot.mjs",
    "snapshot:css:diff": "node scripts/css-surface-snapshot.mjs --diff",
    "visual:eval": "node scripts/visual-snapshot.mjs --eval",
    "visual:diff": "node scripts/visual-snapshot.mjs --diff",
    "visual:update": "node scripts/visual-snapshot.mjs --update",
    "render:capture": "node scripts/verify-liquid-render.mjs --print",
    "render:diff": "node scripts/verify-liquid-render.mjs --diff",
    "render:update": "node scripts/verify-liquid-render.mjs --update",
    "presmoke:release": "npm run build:app",
    "smoke:release": "node scripts/smoke-release.mjs",
    "prebundle": "npm run prepare:runtime",
    "bundle": "pkg . --out-path dist && node scripts/build-mac-shell-app.mjs",
    "prebundle:desktop": "npm run prepare:runtime",
    "bundle:desktop": "pkg . --targets node18-macos-x64,node18-macos-arm64,node18-win-x64 --out-path dist && node scripts/build-mac-shell-app.mjs",
    "prebundle:mac-x64": "npm run prepare:runtime && npm run build:legacy-webkit",
    "bundle:mac-x64": "pkg . --targets node18-macos-x64 --output dist/ai-system-6-macos-x64",
    "bundle:mac-intel-app": "npm run bundle:mac-x64 && xcrun swift build --package-path shell/macos-webview --arch x86_64 && AI_SYSTEM6_APP_DISPLAY_NAME='AI System 6 Beta Intel' AI_SYSTEM6_MACOS_DEPLOYMENT_TARGET=11.0 AI_SYSTEM6_SHELL_BINARY=shell/macos-webview/.build/x86_64-apple-macosx/debug/AISystem6Shell AI_SYSTEM6_SKIP_SWIFT_BUILD=1 node scripts/build-mac-shell-app.mjs --server dist/ai-system-6-macos-x64 && codesign --force --deep --sign - 'dist/AI System 6 Beta Intel.app' && ditto -c -k --sequesterRsrc --keepParent 'dist/AI System 6 Beta Intel.app' 'dist/AI System 6 Beta Intel.zip'",
    "prebundle:mac-arm64": "npm run prepare:runtime",
    "bundle:mac-arm64": "pkg . --targets node18-macos-arm64 --output dist/ai-system-6-macos-arm64 && node scripts/build-mac-shell-app.mjs && codesign --force --deep --sign - 'dist/AI System 6 Beta.app' && ditto -c -k --sequesterRsrc --keepParent 'dist/AI System 6 Beta.app' 'dist/AI System 6 Beta.zip'",
    "bundle:mac-a12z-dtk": "npm run prepare:runtime && npm run build:legacy-webkit && pkg . --targets node18-macos-arm64 --output dist/ai-system-6-macos-a12z-dtk && AI_SYSTEM6_APP_DISPLAY_NAME='AI System 6 Beta DTK' AI_SYSTEM6_MACOS_DEPLOYMENT_TARGET=11.2.3 AI_SYSTEM6_MACOS_TARGET_TRIPLE=arm64-apple-macos11.2.3 AI_SYSTEM6_SWIFT_MCPU=apple-a12 AI_SYSTEM6_EMBED_SWIFT_RUNTIME=1 AI_SYSTEM6_SHELL_BINARY=shell/macos-webview/.build/arm64-apple-macos/debug/AISystem6Shell node scripts/build-mac-shell-app.mjs --server dist/ai-system-6-macos-a12z-dtk && ditto -c -k --sequesterRsrc --keepParent 'dist/AI System 6 Beta DTK.app' 'dist/AI System 6 Beta DTK.zip'",
    "prebundle:win-x64": "npm run prepare:runtime",
    "bundle:win-x64": "pkg . --targets node18-win-x64 --output dist/ai-system-6-win-x64.exe",
    "bundle:mac-app": "npm run bundle:mac-arm64",
    "shell:mac": "swift run --package-path shell/macos-webview AISystem6Shell",
    "shell:mac:no-server": "swift run --package-path shell/macos-webview AISystem6Shell --no-server",
    "shell:mac:app": "node scripts/build-mac-shell-app.mjs",
    "verify:web-safety": "node scripts/verify-web-release-safety.mjs",
    "deploy:web": "node scripts/deploy-web.mjs",
    "release": "node scripts/release.mjs",
    "snapshot:build": "node scripts/build-public-snapshot.mjs",
    "snapshot:verify": "node scripts/verify-public-snapshot-safety.mjs",
    "snapshot:sync": "node scripts/sync-public-snapshot.mjs"
  },
  "overrides": {
    "sanitize-html": "2.17.5"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "esbuild": "^0.25.10",
    "pkg": "^5.8.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.1.0",
    "@lmstudio/sdk": "^1.5.0",
    "@paddlejs-models/ocr": "^1.2.4",
    "canvas": "^3.2.3",
    "https-proxy-agent": "^5.0.1",
    "pdfjs-dist": "4.8.69",
    "stream-markdown-parser": "^1.0.5",
    "tesseract.js": "^7.0.0",
    "three": "^0.184.0"
  }
}
